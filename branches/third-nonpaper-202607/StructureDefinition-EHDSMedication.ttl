       fhir:short [ fhir:v "An identifier or a code for the product (virtual product, branded product, or package). If several identifiers are specified, they shall not have conflicting meanings or very different granularities. An identifier might not exist e.g. for substance-based prescriptions. For the Identifier variant, use an EMA PMS ID or an identifier from a national identification system." ] ;
       fhir:definition [ fhir:v "An identifier or a code for the product (virtual product, branded product, or package). If several identifiers are specified, they shall not have conflicting meanings or very different granularities. An identifier might not exist e.g. for substance-based prescriptions. For the Identifier variant, use an EMA PMS ID or an identifier from a national identification system." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
